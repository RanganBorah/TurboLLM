# Path to the llama.cpp llama-server executable (Windows build).
LLAMA_SERVER_BIN="C:/tools/llama.cpp/llama-server.exe"

# GGUF model files. Target = larger "real" model, Draft = small fast proposer.
# Both must share the same tokenizer family for speculative decoding to work.
TARGET_MODEL_PATH="C:/Users/noah6/Downloads/SpecDecode-main/SpecDecode-main/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf"
DRAFT_MODEL_PATH="C:/Users/noah6/Downloads/SpecDecode-main/SpecDecode-main/models/Llama-3.2-1B-Instruct-Q4_K_M.gguf"

# Ports for the two llama-server child processes managed by the backend.
SPEC_SERVER_PORT=8081
DRAFT_ONLY_SERVER_PORT=8082
STANDARD_SERVER_PORT=8083

# Port for this project's Node/Express orchestration backend.
BACKEND_PORT=8090

# Context window (tokens). Kept modest by default to leave VRAM headroom
# for KV cache on small (4GB) GPUs. Increase if you have more VRAM.
LLAMA_CTX_SIZE=2048

# Number of model layers to offload to GPU. 999 = offload everything possible.
LLAMA_GPU_LAYERS=999
